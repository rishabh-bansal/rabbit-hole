# Copy to .env and fill in. Never commit .env.

# Kimi K3.1 Pro on Cerebras (the fast lane)
CEREBRAS_API_KEY=
# Kimi K3.1 Pro on NVIDIA's API catalog (the GPU lane, free credits at build.nvidia.com)
NVIDIA_API_KEY=

# Optional: route both lanes through an OpenClaw gateway (recommended, used in production).
# Leave OPENCLAW_URL empty to call the providers directly.
OPENCLAW_URL=
OPENCLAW_GATEWAY_TOKEN=

# Optional: shared secret between the Cloudflare Pages proxy and the race server (per-visitor limits)
RH_PROXY_SECRET=

# Optional limits (defaults shown)
# RH_PER_IP_PER_HOUR=4
# RH_DAILY_RACES=120
# RH_GPU_DAILY=40
# RH_LANE_TIMEOUT=300
