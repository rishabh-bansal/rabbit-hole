      },
      "device-pair": {
        "enabled": false
      },
      "document-extract": {
        "enabled": false
      },
      "elevenlabs": {
        "enabled": false
      },
      "fal": {
        "enabled": false
      },
      "file-transfer": {
        "enabled": false
      },
      "geolocation": {
