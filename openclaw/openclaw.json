{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18789,
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "cerebras/moonshotai-kimi-k3.1-pro-trial"
      },
      "thinkingDefault": "low",
      "sandbox": {
        "mode": "off"
      },
      "systemAgent": {
        "agentId": "main"
      }
    },
    "ownership": "explicit",
    "entries": {
      "main": {
        "workspace": "/home/node/.openclaw/workspace"
      },
      "racer-cerebras": {
        "name": "racer-cerebras",
        "workspace": "/home/node/.openclaw/ws/racer-cerebras",
        "agentDir": "/home/node/.openclaw/agents/racer-cerebras/agent",
        "identity": {
          "name": "racer-cerebras"
        },
        "model": "cerebras/moonshotai-kimi-k3.1-pro-trial"
      },
      "racer-nvidia": {
        "name": "racer-nvidia",
        "workspace": "/home/node/.openclaw/ws/racer-nvidia",
        "agentDir": "/home/node/.openclaw/agents/racer-nvidia/agent",
        "identity": {
          "name": "racer-nvidia"
        },
        "model": "nvidia/moonshotai/kimi-k3.1-pro"
      },
      "racer-qwen": {
        "name": "racer-qwen",
        "workspace": "/home/node/.openclaw/ws/racer-qwen",
        "agentDir": "/home/node/.openclaw/agents/racer-qwen/agent",
        "identity": {
          "name": "racer-qwen"
        },
        "model": "cerebras/qwen-3.8-27b"
      },
      "storyteller": {
        "name": "storyteller",
        "workspace": "/home/node/.openclaw/ws/storyteller",
        "agentDir": "/home/node/.openclaw/agents/storyteller/agent",
        "identity": {
          "name": "storyteller"
        },
        "model": "cerebras/moonshotai-kimi-k3.1-pro-trial"
      },
      "racer-gptoss": {
        "name": "racer-gptoss",
        "workspace": "/home/node/.openclaw/ws/racer-gptoss",
        "agentDir": "/home/node/.openclaw/agents/racer-gptoss/agent",
        "identity": {
          "name": "racer-gptoss"
        },
        "model": "cerebras/gpt-oss-120b"
      },
      "storyteller-gptoss": {
        "name": "storyteller-gptoss",
        "workspace": "/home/node/.openclaw/ws/storyteller-gptoss",
        "agentDir": "/home/node/.openclaw/agents/storyteller-gptoss/agent",
        "identity": {
          "name": "storyteller-gptoss"
        },
        "model": "cerebras/gpt-oss-120b"
      },
      "storyteller-qwen": {
        "name": "storyteller-qwen",
        "workspace": "/home/node/.openclaw/ws/storyteller-qwen",
        "agentDir": "/home/node/.openclaw/agents/storyteller-qwen/agent",
        "identity": {
          "name": "storyteller-qwen"
        },
        "model": "cerebras/qwen-3.8-27b"
      }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "cerebras": {
        "baseUrl": "https://api.cerebras.ai/v1",
        "api": "openai-completions",
        "apiKey": "${CEREBRAS_API_KEY}",
        "models": [
          {
            "id": "moonshotai-kimi-k3.1-pro-trial",
            "name": "Kimi K3.1 Pro (Cerebras)",
            "reasoning": true,
            "input": [
              "text"
            ],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "compat": {
              "supportsTools": true,
              "supportsStrictMode": false,
              "supportsReasoningEffort": true,
              "supportedReasoningEfforts": [
                "low",
                "high",
                "max"
              ]
            }
          },
          {
            "id": "qwen-3.8-27b",
            "name": "Qwen 3.8 27B (Cerebras)",
            "reasoning": true,
            "input": [
              "text"
            ],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "compat": {
              "supportsTools": true,
              "supportsStrictMode": false
            }
          },
          {
            "id": "gpt-oss-120b",
            "name": "GPT-OSS 120B (Cerebras)",
            "reasoning": true,
            "input": [
              "text"
            ],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "compat": {
              "supportsTools": true,
              "supportsStrictMode": false,
              "supportsReasoningEffort": true,
              "supportedReasoningEfforts": [
                "low",
                "medium",
                "high"
              ]
            }
          }
        ]
      },
      "nvidia": {
        "baseUrl": "https://integrate.api.nvidia.com/v1",
        "api": "openai-completions",
        "apiKey": "${NVIDIA_API_KEY}",
        "models": [
          {
            "id": "moonshotai/kimi-k3.1-pro",
            "name": "Kimi K3.1 Pro (NVIDIA GPU)",
            "reasoning": true,
            "input": [
              "text"
            ],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "compat": {
              "supportsTools": true,
              "supportsStrictMode": false,
              "supportsReasoningEffort": true,
              "supportedReasoningEfforts": [
                "low",
                "high",
                "max"
              ]
            }
          }
        ],
        "timeoutSeconds": 295
      }
    }
  },
  "tools": {
    "profile": "minimal",
    "deny": [
      "group:runtime",
      "group:fs",
      "group:web",
      "group:automation",
      "group:ui",
      "group:nodes",
      "sessions_spawn",
      "sessions_send"
    ],
    "exec": {
      "security": "deny",
      "ask": "always"
    },
    "elevated": {
      "enabled": false
    }
  },
  "plugins": {
    "entries": {
      "alibaba": {
        "enabled": false
      },
      "anthropic": {
        "enabled": false
      },
      "azure-speech": {
        "enabled": false
      },
      "bifrost": {
        "enabled": false
      },
      "browser": {
        "enabled": false
      },
      "canvas": {
        "enabled": false
      },
      "clawrouter": {
        "enabled": false
      },
      "copilot-proxy": {
        "enabled": false
      },
      "cua-computer": {
        "enabled": false
      },
      "deepgram": {
